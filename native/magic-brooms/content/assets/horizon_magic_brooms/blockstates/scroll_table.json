        "model": "horizon_magic_brooms:block/scroll_table_preview_lightning"
      }
    },
    {
      "when": {
        "stage": "ender"
      },
      "apply": {
        "model": "horizon_magic_brooms:block/scroll_table_preview_ender"
      }
    },
    {
      "when": {
