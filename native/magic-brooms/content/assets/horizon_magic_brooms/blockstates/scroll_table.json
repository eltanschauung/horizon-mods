      }
    },
    {
      "when": {
        "stage": "fire"
      },
      "apply": {
        "model": "horizon_magic_brooms:block/scroll_table_preview_fire"
      }
    },
    {
      "when": {
        "stage": "ice"
      },
      "apply": {
        "model": "horizon_magic_brooms:block/scroll_table_preview_ice"
      }
